# Copy to .env.local for local development. Never commit real values.

# Leave DATABASE_URL empty to use the embedded local PGlite database (development only).
# For Supabase, use the project's Postgres connection string (server-side only).
DATABASE_URL=

# Public base URL used in emailed links and printed QR codes.
APP_BASE_URL=http://localhost:3000

# Email channel: "dev" writes messages to the local dev inbox (/dev/inbox).
# Production must use a real provider; "dev" is rejected when NODE_ENV=production.
EMAIL_PROVIDER=dev
