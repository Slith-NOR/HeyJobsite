# Copy to .env.local for local development. Never commit real values.

# Leave DATABASE_URL empty to use the embedded local PGlite database (development only).
# For Supabase, use the project's Postgres connection string (server-side only).
DATABASE_URL=

# Public base URL used in emailed links and printed QR codes. Production: https://app.heyjobsite.com
APP_BASE_URL=http://localhost:3000

# Passkey domain. Production: heyjobsite.com (the parent domain, so passkeys survive moving
# between app.heyjobsite.com and heyjobsite.com). Empty = the APP_BASE_URL host (localhost locally).
PASSKEY_RP_ID=

# Email channel: "dev" writes messages to the local dev inbox (/dev/inbox); "postmark" sends for real.
# Production must use postmark; "dev" is rejected when NODE_ENV=production.
EMAIL_PROVIDER=dev

# Postmark (only when EMAIL_PROVIDER=postmark). The Server API token is a secret: set it in Vercel's
# environment variables, never in a committed file. "POSTMARK_API_TEST" accepts mail and sends nothing.
POSTMARK_SERVER_TOKEN=
# Defaults shown; the From address must be on a domain verified in Postmark.
EMAIL_FROM=HeyJobsite <no-reply@mail.heyjobsite.com>
EMAIL_REPLY_TO=support@heyjobsite.com
